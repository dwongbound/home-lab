# Copy to .env (gitignored) and fill in. Every value here has a working
# default for jarvis except HA_TOKEN. Mock mode needs none of it.

# mock (default): made-up numbers. live: read the real PC.
DATA_SOURCE=mock

# Where the server listens. 127.0.0.1 is this PC only; 0.0.0.0 also lets
# your phone and Mac reach it over Tailscale (see README, "Reaching it").
HOST=127.0.0.1
PORT=4180

# Home Assistant. Make a long-lived token under your HA profile, Security tab.
# It stays on the server; the page never sees it.
HA_URL=http://192.168.68.94:8123
HA_TOKEN=

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
# How long Load keeps Gemma in memory. -1 = forever (how jarvis runs it).
OLLAMA_KEEP_ALIVE=-1
OPEN_WEBUI_URL=https://jarvis.snakebird-ph.ts.net
JARVIS_URL=https://jarvis.snakebird-ph.ts.net:8443
JARVIS_UNIT=jarvis

# WSL's nvidia-smi, which isn't on PATH.
NVIDIA_SMI=/usr/lib/wsl/lib/nvidia-smi

# Where WSL mounts the Windows C: drive.
WINDOWS_DRIVE=/mnt/c
