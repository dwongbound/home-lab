# systemd unit for the home-lab server on jarvis (WSL Ubuntu, user dwong).
# Install: see README, "Running it on jarvis".
[Unit]
Description=home-lab server for the Jarvis apps
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=dwong
WorkingDirectory=/home/dwong/home-lab
ExecStart=/usr/bin/env node server/index.mjs
Restart=on-failure
RestartSec=5
# Keep it small: Gemma needs the memory more than this server does.
MemoryMax=200M
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
